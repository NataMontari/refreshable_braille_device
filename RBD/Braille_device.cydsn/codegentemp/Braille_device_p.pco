dont_use_io iocell 0 6
dont_use_io iocell 0 7
dont_use_io iocell 6 0
dont_use_io iocell 6 1
set_io "\LCD_Char_1:LCDPort(6)\" iocell 3 6
set_io "\LCD_Char_1:LCDPort(5)\" iocell 3 5
set_io "\LCD_Char_1:LCDPort(3)\" iocell 3 3
set_io "\LCD_Char_1:LCDPort(4)\" iocell 3 4
set_location "ClockBlock" m0s8clockblockcell -1 -1 0
set_location "ClockGenBlock" m0s8clockgenblockcell -1 -1 0
set_io "MOTOR_1_DIR(0)" iocell 1 0
set_io "MOTOR_1_STEP(0)" iocell 1 3
set_io "MOTOR_1_EN(0)" iocell 0 0
set_io "\LCD_Char_1:LCDPort(0)\" iocell 3 0
set_io "MOTOR_2_DIR(0)" iocell 1 2
set_io "MOTOR_2_STEP(0)" iocell 1 6
set_io "MOTOR_2_EN(0)" iocell 0 5
set_io "RED_LED(0)" iocell 2 6
set_io "BLUE_LED(0)" iocell 3 7
set_io "\LCD_Char_1:LCDPort(2)\" iocell 3 2
set_io "\LCD_Char_1:LCDPort(1)\" iocell 3 1
